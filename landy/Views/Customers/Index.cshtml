@model IReadOnlyList<CustomerSummaryDto>
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "Customer Management";
    string? currentSearch = ViewBag.SearchTerm as string;
    CustomerStatus? currentStatus = ViewBag.Status as CustomerStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Customer Management</h2>
        <p class="text-muted mb-0">Official business client registry &mdash; Authorized staff access only</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Register New Customer
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search and Filter Form -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white">🔍</span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by full name, phone number, or email..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var val in Enum.GetValues<CustomerStatus>())
                    {
                        if (currentStatus == val)
                        {
                            <option value="@val" selected>@val</option>
                        }
                        else
                        {
                            <option value="@val">@val</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">Search</button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentStatus.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Customer Records Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Customer Name</th>
                    <th>Phone Number</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Properties</th>
                    <th>Portal Access</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <p class="mb-1">No customer records found matching the criteria.</p>
                            @if (!string.IsNullOrEmpty(currentSearch) || currentStatus.HasValue)
                            {
                                <a asp-action="Index" class="btn btn-sm btn-link">Clear search filters</a>
                            }
                        </td>
                    </tr>
                }
                @foreach (var customer in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@customer.Id" class="text-decoration-none">
                                @customer.FullName
                            </a>
                        </td>
                        <td>@customer.PhoneNumber</td>
                        <td>@(string.IsNullOrEmpty(customer.Email) ? "-" : customer.Email)</td>
                        <td>
                            @switch (customer.Status)
                            {
                                case CustomerStatus.Active:
                                    <span class="badge bg-success">Active</span>
                                    break;
                                case CustomerStatus.Inactive:
                                    <span class="badge bg-warning text-dark">Inactive</span>
                                    break;
                                case CustomerStatus.Archived:
                                    <span class="badge bg-secondary">Archived</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @customer.PropertyCount @(customer.PropertyCount == 1 ? "property" : "properties")
                            </span>
                        </td>
                        <td>
                            @if (customer.HasPortalAccount)
                            {
                                <span class="badge bg-info text-dark">Linked</span>
                            }
                            else
                            {
                                <span class="text-muted small">Not provisioned</span>
                            }
                        </td>
                        <td>@customer.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary me-1">
                                View
                            </a>
                            <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary me-1">
                                Edit
                            </a>
                            @if (customer.Status != CustomerStatus.Archived)
                            {
                                <form asp-action="Archive" asp-route-id="@customer.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Archive record for @customer.FullName? This will also deactivate portal access.');">
                                        Archive
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
