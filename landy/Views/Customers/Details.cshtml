@model CustomerDetailDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"Customer Details - {Model.FullName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">@Model.FullName</h2>
            @switch (Model.Status)
            {
                case CustomerStatus.Active:
                    <span class="badge bg-success fs-6">Active</span>
                    break;
                case CustomerStatus.Inactive:
                    <span class="badge bg-warning text-dark fs-6">Inactive</span>
                    break;
                case CustomerStatus.Archived:
                    <span class="badge bg-secondary fs-6">Archived</span>
                    break;
            }
        </div>
        <p class="text-muted mb-0 small">Customer Reference: #CUST-@Model.Id.ToString("D5") &bull; Created: @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm UTC")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            Edit Profile
        </a>
        @if (!Model.HasPortalAccount && Model.Status != CustomerStatus.Archived)
        {
            <a asp-controller="CustomerAccount" asp-action="Provision" asp-route-customerId="@Model.Id" class="btn btn-primary">
                Provision Portal Account
            </a>
        }
        @if (Model.Status == CustomerStatus.Archived)
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success">
                    Restore to Active
                </button>
            </form>
        }
        else
        {
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Archive this customer record?');">
                    Archive
                </button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to List
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Customer Profile & Contact -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Client Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Full Legal Name</div>
                    <div class="col-sm-8 fw-semibold">@Model.FullName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Primary Phone</div>
                    <div class="col-sm-8 fw-semibold">@Model.PhoneNumber</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Email Address</div>
                    <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Email) ? "Not provided" : Model.Email)</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Physical / Business Address</div>
                    <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Address) ? "Not provided" : Model.Address)</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">National ID / Tax Number</div>
                    <div class="col-sm-8">@(string.IsNullOrEmpty(Model.NationalIdOrTaxNumber) ? "Not provided" : Model.NationalIdOrTaxNumber)</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Account Status</div>
                    <div class="col-sm-8">@Model.Status</div>
                </div>
                <div class="row">
                    <div class="col-sm-4 text-muted">Last Modified</div>
                    <div class="col-sm-8">@(Model.ModifiedAtUtc.HasValue ? Model.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm UTC") : "Never")</div>
                </div>
            </div>
        </div>

        <!-- Associated Properties -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="fw-bold mb-0">Associated Properties</h5>
                    <span class="badge bg-primary">@Model.PropertyCount Total</span>
                </div>
                <a asp-controller="Properties" asp-action="Create" asp-route-customerId="@Model.Id" class="btn btn-sm btn-outline-primary">
                    + Add Property
                </a>
            </div>
            <div class="card-body p-4">
                @if (Model.PropertyTitles.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var title in Model.PropertyTitles)
                        {
                            <li class="list-group-item px-0">@title</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0 small">No real-estate properties currently linked to this customer dossier.</p>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Confidential Internal Notes & Portal Link -->
    <div class="col-lg-5">
        <!-- Internal Staff Notes (Confidential) -->
        <div class="card shadow-sm border-0 border-top border-warning border-3 mb-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0">Internal Staff Notes</h5>
                    <span class="badge bg-warning text-dark">Confidential &bull; Staff Only</span>
                </div>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrWhiteSpace(Model.InternalNotes))
                {
                    <div class="p-3 bg-light rounded border">
                        <p class="mb-0 text-dark" style="white-space: pre-wrap;">@Model.InternalNotes</p>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic mb-0 small">No internal notes entered for this customer.</p>
                }
                <div class="mt-3 text-muted small">
                    <em>Security Notice: These internal notes are protected and are strictly never visible in the customer portal.</em>
                </div>
            </div>
        </div>

        <!-- Portal Account Status -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Portal Login Account</h5>
            </div>
            <div class="card-body p-4">
                @if (Model.HasPortalAccount)
                {
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-success me-2">Linked</span>
                        <span>Identity User ID: <code class="small">@Model.IdentityUserId</code></span>
                    </div>
                    <p class="text-muted small mb-0">
                        This client has an authorized login credential. They can access the customer portal to view approved documents and records.
                    </p>
                }
                else
                {
                    <div class="alert alert-light border mb-3">
                        <p class="small text-muted mb-0">No portal login account has been provisioned yet for this business customer.</p>
                    </div>
                    @if (Model.Status != CustomerStatus.Archived)
                    {
                        <a asp-controller="CustomerAccount" asp-action="Provision" asp-route-customerId="@Model.Id" class="btn btn-outline-primary btn-sm w-100">
                            Provision Portal Access
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>
