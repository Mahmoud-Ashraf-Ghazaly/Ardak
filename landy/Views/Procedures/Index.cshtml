@model IReadOnlyList<Ardak.Application.DTOs.ProcedureSummaryDto>
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "Procedures";
    var filter = ViewBag.Filter as Ardak.Application.DTOs.ProcedureSearchFilterDto
                 ?? new Ardak.Application.DTOs.ProcedureSearchFilterDto();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-clipboard2-check me-2"></i>Procedures</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> New Procedure
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

{{!-- Filter Form --}}
<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Procedure Type</label>
                <select name="Type" asp-items="@ViewBag.ProcedureTypes" class="form-select">
                    <option value="">All Types</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="Status" asp-items="@ViewBag.ProcedureStatuses" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Overdue Only</label>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" name="OverdueOnly" value="true"
                           @(filter.OverdueOnly == true ? "checked" : "") id="chkOverdue">
                    <label class="form-check-label" for="chkOverdue">Show overdue</label>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-outline-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Clear</a>
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-clipboard2-x fs-1 d-block mb-2"></i>
        No procedures found. <a asp-action="Create">Create the first one.</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Type</th>
                        <th>Property</th>
                        <th>Application #</th>
                        <th>Authority</th>
                        <th>Status</th>
                        <th>Next Deadline</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary">@p.TypeLabel</span>
                            </td>
                            <td>
                                <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.PropertyId"
                                   class="text-decoration-none fw-semibold">
                                    @p.PropertyReferenceNumber
                                </a>
                                <div class="small text-muted">@p.PropertyTitle</div>
                            </td>
                            <td>@(p.ApplicationNumber ?? "—")</td>
                            <td>@(p.ResponsibleAuthority ?? "—")</td>
                            <td><partial name="_ProcedureStatusBadge" model="p.Status" /></td>
                            <td>
                                @if (p.NextActionDeadline.HasValue)
                                {
                                    var cssClass = p.HasOverdueDeadline ? "text-danger fw-bold" : "text-body";
                                    <span class="@cssClass">
                                        @p.NextActionDeadline.Value.ToString("dd MMM yyyy")
                                        @if (p.HasOverdueDeadline)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill ms-1"></i>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-secondary me-1">View</a>
                                <a asp-action="Edit" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="text-muted small mt-2">Showing @Model.Count procedure(s).</div>
}
