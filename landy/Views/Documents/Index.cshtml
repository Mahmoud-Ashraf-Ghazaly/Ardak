@model IReadOnlyList<Ardak.Application.DTOs.DocumentSummaryDto>
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "Documents";
    var filter = ViewBag.Filter as Ardak.Application.DTOs.DocumentSearchFilterDto ?? new Ardak.Application.DTOs.DocumentSearchFilterDto();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-file-earmark-lock me-2"></i>Document Management</h1>
    <a asp-action="Upload" class="btn btn-primary">
        <i class="bi bi-cloud-arrow-up me-1"></i> Upload Document
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

{{!-- Search & Filter Card --}}
<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control" placeholder="Title, ref #, or filename..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Document Type</label>
                <select name="Type" asp-items="@ViewBag.DocumentTypes" class="form-select">
                    <option value="">All Document Types</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Confidentiality</label>
                <select name="ConfidentialityLevel" asp-items="@ViewBag.ConfidentialityLevels" class="form-select">
                    <option value="">All Confidentiality Levels</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Visibility & Archive</label>
                <div class="d-flex gap-3 mt-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsCustomerVisible" value="true"
                               @(filter.IsCustomerVisible == true ? "checked" : "") id="chkVisible">
                        <label class="form-check-label" for="chkVisible">Customer Visible</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsArchived" value="true"
                               @(filter.IsArchived == true ? "checked" : "") id="chkArchived">
                        <label class="form-check-label" for="chkArchived">Archived</label>
                    </div>
                </div>
            </div>
            <div class="col-12 d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-funnel me-1"></i> Apply Filters
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
        No documents found. <a asp-action="Upload">Upload the first document.</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title & Type</th>
                        <th>Association</th>
                        <th>Confidentiality</th>
                        <th>Customer Access</th>
                        <th>File Details</th>
                        <th>Uploaded (UTC)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@doc.Id" class="text-decoration-none">
                                        @doc.Title
                                    </a>
                                </div>
                                <div class="small text-muted">
                                    <span class="badge bg-secondary">@doc.TypeLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(doc.ReferenceNumber))
                                    {
                                        <span class="ms-1">Ref: <code>@doc.ReferenceNumber</code></span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (doc.PropertyId.HasValue)
                                {
                                    <div>
                                        <i class="bi bi-geo-alt text-primary me-1"></i>
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@doc.PropertyId">
                                            @doc.PropertyReferenceNumber
                                        </a>
                                    </div>
                                }
                                @if (doc.CustomerId.HasValue)
                                {
                                    <div class="small text-muted">
                                        <i class="bi bi-person text-secondary me-1"></i>
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@doc.CustomerId">
                                            @doc.CustomerName
                                        </a>
                                    </div>
                                }
                                @if (doc.ProcedureId.HasValue)
                                {
                                    <div class="small text-muted">
                                        <i class="bi bi-clipboard2-check text-success me-1"></i>
                                        <a asp-controller="Procedures" asp-action="Details" asp-route-id="@doc.ProcedureId">
                                            @doc.ProcedureTypeLabel
                                        </a>
                                    </div>
                                }
                                @if (!doc.PropertyId.HasValue && !doc.CustomerId.HasValue && !doc.ProcedureId.HasValue)
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <partial name="_ConfidentialityBadge" model="doc.ConfidentialityLevel" />
                                @if (doc.IsArchived)
                                {
                                    <span class="badge bg-dark ms-1">Archived</span>
                                }
                            </td>
                            <td>
                                @if (doc.IsCustomerVisible)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">
                                        <i class="bi bi-eye me-1"></i>Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">
                                        <i class="bi bi-eye-slash me-1"></i>Private
                                    </span>
                                }
                            </td>
                            <td>
                                <div>@doc.OriginalFileName</div>
                                <div class="small text-muted">@doc.FormattedFileSize &bull; @doc.FileExtension</div>
                            </td>
                            <td>
                                <div class="small">@doc.UploadedAtUtc.ToString("dd MMM yyyy")</div>
                                <div class="small text-muted">@doc.UploadedAtUtc.ToString("HH:mm") UTC</div>
                            </td>
                            <td class="text-end">
                                <a asp-action="Download" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-success me-1" title="Download File">
                                    <i class="bi bi-download"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary me-1">
                                    View
                                </a>
                                <a asp-action="Edit" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="text-muted small mt-2">Showing @Model.Count document(s).</div>
}
