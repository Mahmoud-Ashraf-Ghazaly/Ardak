@model UpdatePropertyDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"Edit Property - {Model.ReferenceNumber}";
    var customers = ViewBag.Customers as SelectList;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold mb-0">Edit Property Profile</h3>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Cancel</a>
                </div>
                <p class="text-muted small mb-4">
                    Update property record specifications and operational status.
                </p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
                {
                    <div class="alert alert-danger" role="alert">
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="card mb-4 bg-light border-0">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-primary mb-3">1. Identification & Status</h6>
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <label asp-for="ReferenceNumber" class="form-label fw-semibold"></label>
                                    <input asp-for="ReferenceNumber" class="form-control" />
                                    <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="Type" class="form-label fw-semibold"></label>
                                    <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<PropertyType>()"></select>
                                    <span asp-validation-for="Type" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="Status" class="form-label fw-semibold"></label>
                                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<PropertyStatus>()"></select>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="PrimaryCustomerId" class="form-label fw-semibold"></label>
                                    <select asp-for="PrimaryCustomerId" class="form-select" asp-items="customers"></select>
                                    <span asp-validation-for="PrimaryCustomerId" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label fw-semibold"></label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="mb-0">
                                <label asp-for="Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4 bg-light border-0">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-primary mb-3">2. Location Details</h6>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Governorate" class="form-label fw-semibold"></label>
                                    <input asp-for="Governorate" class="form-control" />
                                    <span asp-validation-for="Governorate" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="City" class="form-label fw-semibold"></label>
                                    <input asp-for="City" class="form-control" />
                                    <span asp-validation-for="City" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="DistrictOrArea" class="form-label fw-semibold"></label>
                                    <input asp-for="DistrictOrArea" class="form-control" />
                                    <span asp-validation-for="DistrictOrArea" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="mb-0">
                                <label asp-for="AddressDetails" class="form-label fw-semibold"></label>
                                <input asp-for="AddressDetails" class="form-control" />
                                <span asp-validation-for="AddressDetails" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4 bg-light border-0">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-primary mb-3">3. Measurements, Coordinates & Deed Info</h6>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="AreaMeasurement" class="form-label fw-semibold"></label>
                                    <input asp-for="AreaMeasurement" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="AreaMeasurement" class="text-danger small"></span>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label asp-for="AreaUnit" class="form-label fw-semibold"></label>
                                    <input asp-for="AreaUnit" class="form-control" />
                                    <span asp-validation-for="AreaUnit" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="Latitude" class="form-label fw-semibold"></label>
                                    <input asp-for="Latitude" class="form-control" type="number" step="any" />
                                    <span asp-validation-for="Latitude" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="Longitude" class="form-label fw-semibold"></label>
                                    <input asp-for="Longitude" class="form-control" type="number" step="any" />
                                    <span asp-validation-for="Longitude" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-0">
                                    <label asp-for="OwnershipType" class="form-label fw-semibold"></label>
                                    <input asp-for="OwnershipType" class="form-control" />
                                    <span asp-validation-for="OwnershipType" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-0">
                                    <label asp-for="DeedOrTitleNumber" class="form-label fw-semibold"></label>
                                    <input asp-for="DeedOrTitleNumber" class="form-control" />
                                    <span asp-validation-for="DeedOrTitleNumber" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4 bg-light border-0">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-2">
                                <h6 class="fw-bold text-primary mb-0">4. Internal Staff Notes</h6>
                                <span class="badge bg-warning text-dark ms-2">Confidential &bull; Staff Only</span>
                            </div>
                            <textarea asp-for="InternalNotes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="InternalNotes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to Details</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
