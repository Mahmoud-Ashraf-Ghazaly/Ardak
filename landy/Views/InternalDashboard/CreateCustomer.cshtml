@model Customer
@{
    ViewData["Title"] = "Create Customer Record";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-1">Create Customer Record</h3>
                <p class="text-muted small mb-4">Add a new business customer record to the internal registry.</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
                {
                    <div class="alert alert-danger" role="alert">
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="CreateCustomer" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Customer or Company Name" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="customer@domain.com" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+1 234 567 890" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NationalIdOrTaxNumber" class="form-label fw-semibold">National ID / Tax Number</label>
                        <input asp-for="NationalIdOrTaxNumber" class="form-control" placeholder="Optional" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="InternalNotes" class="form-label fw-semibold">
                            Internal Staff Notes <span class="badge bg-warning text-dark">Confidential</span>
                        </label>
                        <textarea asp-for="InternalNotes" class="form-control" rows="3" placeholder="Strictly internal staff notes. This field is never shown to the customer portal."></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
                        <button type="submit" class="btn btn-primary">Save Customer Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
