@model IReadOnlyList<Ardak.Application.DTOs.CustomerPropertySummaryDto>
@{
    ViewData["Title"] = "My Properties";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Client Portal</a></li>
        <li class="breadcrumb-item active">My Properties</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">
        <i class="bi bi-buildings text-primary me-2"></i>My Properties
    </h1>
    <span class="badge bg-light text-muted border">Showing @Model.Count property record(s)</span>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-building-slash fs-1 d-block mb-2"></i>
        No properties are currently associated with your account.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary">@p.Type</span>
                            <span class="badge bg-secondary">@p.Status</span>
                        </div>
                        <h5 class="fw-bold mb-1">@p.Title</h5>
                        <p class="text-muted small mb-3">Ref: <code>@p.ReferenceNumber</code></p>

                        <div class="small mb-3">
                            <div><i class="bi bi-geo-alt me-1 text-muted"></i>@p.DistrictOrArea, @p.City</div>
                            <div><i class="bi bi-rulers me-1 text-muted"></i>@p.AreaMeasurement.ToString("N0") @p.AreaUnit</div>
                            <div><i class="bi bi-person-check me-1 text-muted"></i>Ownership: <strong>@p.OwnershipRole</strong></div>
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <div class="small text-muted">
                                <span><i class="bi bi-clipboard2-check me-1"></i>@p.ApprovedProceduresCount procedures</span>
                            </div>
                            <a asp-action="PropertyDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                Details &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
