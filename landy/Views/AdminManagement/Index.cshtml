@model IReadOnlyList<AdminUserDto>
@{
    ViewData["Title"] = "Admin Management (SuperAdmin Only)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Administrative Accounts</h2>
        <p class="text-muted mb-0">Manage SuperAdmin and Admin accounts. Only SuperAdmin can access this console.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Provision New Admin
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created (UTC)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            @admin.FullName
                            @if (admin.IsPrimarySuperAdmin)
                            {
                                <span class="badge bg-warning text-dark ms-1">Primary SuperAdmin</span>
                            }
                        </td>
                        <td>@admin.Email</td>
                        <td>
                            @if (admin.Role == AppRoles.SuperAdmin)
                            {
                                <span class="badge bg-danger">@admin.Role</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">@admin.Role</span>
                            }
                        </td>
                        <td>
                            @if (admin.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Deactivated</span>
                            }
                        </td>
                        <td>@admin.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            @if (admin.IsPrimarySuperAdmin)
                            {
                                <span class="text-muted small fst-italic">Protected Account</span>
                            }
                            else
                            {
                                <form asp-action="ToggleStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@admin.Id" />
                                    @if (admin.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate this Admin account? Active sessions will be revoked.');">
                                            Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Activate
                                        </button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
